# Self-hosted LLM keys are optional when using local Ollama or browser BYOK.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Hosted public mode: keys arrive per request; environment keys are ignored.
# LUMIN_HOSTED=1
# Exact frontend origins, comma-separated; no wildcard.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
HOST=127.0.0.1
PORT=8000

# Self-hosted remote access token. Generate a long random token for Docker.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
LUMINRAG_API_TOKEN=

# Optional local data location. Hosted workspaces use temporary directories.
# LUMINRAG_DATA_DIR=/absolute/path/to/luminrag-data
# LUMINRAG_SKIP_DOTENV=1
# LUMIN_RELOAD=1

# Hosted file limit defaults to 50 MiB. Self-host defaults to 64 MiB.
# LUMINRAG_MAX_UPLOAD_BYTES=52428800
# LUMINRAG_MAX_CONCURRENT_INFERENCE=4
# LUMIN_MAX_WORKSPACES=8
# LUMIN_MAX_WORKSPACE_BYTES=268435456
# LUMIN_MODEL_THREADS=2
# LUMINRAG_INGEST_LLM_WORKERS=4
# FORWARDED_ALLOW_IPS=exact-trusted-proxy-IPs-or-CIDRs
# FASTEMBED_CACHE_PATH=/absolute/path/to/models
# HF_HUB_OFFLINE=1
