# Copy this file to .env, fill the two required values, then run:
# docker compose up -d --build --wait --wait-timeout 300
# Real .env files are ignored by Git and excluded from Docker builds.

# Required: hostname only, without https://, a path, or a trailing slash.
LUMIN_HOSTNAME=luminrag.karaberke.com

# Required: create a NEW, dedicated LuminRAG tunnel in the Cloudflare dashboard.
# Paste only its token here, not the entire installation command.
# Do not reuse a tunnel serving Jellyfin, Nextcloud, Immich, or other apps.
# Dashboard route: luminrag.karaberke.com -> HTTP -> 127.0.0.1:8080
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: defaults are sized for a small pilot on the shared 8 GiB server.
COMPOSE_PROJECT_NAME=luminrag
COMPOSE_PARALLEL_LIMIT=1
LUMIN_BACKEND_CPUS=1.0
LUMIN_BACKEND_MEMORY=2g
LUMIN_FRONTEND_CPUS=0.25
LUMIN_FRONTEND_MEMORY=192m
LUMIN_TUNNEL_CPUS=0.25
LUMIN_TUNNEL_MEMORY=128m
LUMIN_TEMP_SIZE=768m
LUMIN_MODEL_THREADS=1
# Concurrent graph-extraction requests (network I/O, not CPU model threads).
LUMINRAG_INGEST_LLM_WORKERS=4
LUMINRAG_MAX_CONCURRENT_INFERENCE=1
LUMIN_MAX_WORKSPACES=2
LUMIN_MAX_WORKSPACE_BYTES=67108864
LUMINRAG_MAX_UPLOAD_BYTES=10485760

# No shared OpenAI/Anthropic/OpenRouter API key is needed here. Each visitor enters
# their own provider key in AI settings. Originals, graphs and chats are saved
# in that visitor's browser; export .lumin backups before clearing browser data.
# For persistent storage, Ollama or audio/video, use docker-compose.selfhost.yml
# with .env.selfhost.example instead.
